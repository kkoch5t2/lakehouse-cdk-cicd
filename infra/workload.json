{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "One environment: dbt/Athena medallion lab. Existing SSE-S3 buckets; dedicated prefix.",
  "Parameters": {
    "DataBucket": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]"
    },
    "ResultsBucket": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]"
    },
    "ImageUri": {
      "Type": "String",
      "Description": "Same-account private ECR image URI pinned to sha256 digest"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.87.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "Attachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "Subnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.87.1.0/24"
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "Route": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "DependsOn": "Attachment"
    },
    "Association": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet"
        },
        "RouteTableId": {
          "Ref": "RouteTable"
        }
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "GroupDescription": "No inbound; HTTPS outbound for AWS APIs",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "BaseDatabase": {
      "Type": "AWS::Glue::Database",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseInput": {
          "Name": "medallion_lab"
        }
      }
    },
    "BronzeDatabase": {
      "Type": "AWS::Glue::Database",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseInput": {
          "Name": "medallion_lab_bronze"
        }
      }
    },
    "SilverDatabase": {
      "Type": "AWS::Glue::Database",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseInput": {
          "Name": "medallion_lab_silver"
        }
      }
    },
    "GoldDatabase": {
      "Type": "AWS::Glue::Database",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseInput": {
          "Name": "medallion_lab_gold"
        }
      }
    },
    "RawOrders": {
      "Type": "AWS::Glue::Table",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseName": {
          "Ref": "BronzeDatabase"
        },
        "TableInput": {
          "Name": "orders_raw",
          "TableType": "EXTERNAL_TABLE",
          "Parameters": {
            "classification": "csv",
            "skip.header.line.count": "1"
          },
          "StorageDescriptor": {
            "Columns": [
              {
                "Name": "order_id",
                "Type": "string"
              },
              {
                "Name": "customer_name",
                "Type": "string"
              },
              {
                "Name": "amount",
                "Type": "string"
              },
              {
                "Name": "status",
                "Type": "string"
              },
              {
                "Name": "order_date",
                "Type": "string"
              },
              {
                "Name": "source_updated_at",
                "Type": "string"
              },
              {
                "Name": "event_id",
                "Type": "string"
              }
            ],
            "Location": {
              "Fn::Sub": "s3://${DataBucket}/medallion-lab/bronze/orders/"
            },
            "InputFormat": "org.apache.hadoop.mapred.TextInputFormat",
            "OutputFormat": "org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat",
            "SerdeInfo": {
              "SerializationLibrary": "org.apache.hadoop.hive.serde2.OpenCSVSerde",
              "Parameters": {
                "separatorChar": ",",
                "quoteChar": "\"",
                "escapeChar": "\\"
              }
            }
          }
        }
      }
    },
    "Workgroup": {
      "Type": "AWS::Athena::WorkGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-wg"
        },
        "WorkGroupConfiguration": {
          "EngineVersion": {
            "SelectedEngineVersion": "Athena engine version 3"
          },
          "EnforceWorkGroupConfiguration": true,
          "BytesScannedCutoffPerQuery": 1073741824,
          "ResultConfiguration": {
            "OutputLocation": {
              "Fn::Sub": "s3://${ResultsBucket}/medallion-lab/query-results/"
            },
            "ExpectedBucketOwner": {
              "Ref": "AWS::AccountId"
            },
            "EncryptionConfiguration": {
              "EncryptionOption": "SSE_S3"
            }
          }
        }
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 7
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {}
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "lab",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Logs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "lab",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketLocation"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${DataBucket}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${ResultsBucket}"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${DataBucket}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${ResultsBucket}"
                    }
                  ],
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": [
                        "medallion-lab",
                        "medallion-lab/*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload",
                    "s3:ListMultipartUploadParts"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${DataBucket}/medallion-lab/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${ResultsBucket}/medallion-lab/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "athena:StartQueryExecution",
                    "athena:GetQueryExecution",
                    "athena:GetQueryResults",
                    "athena:StopQueryExecution",
                    "athena:GetWorkGroup",
                    "athena:ListQueryExecutions"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:athena:${AWS::Region}:${AWS::AccountId}:workgroup/${Workgroup}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "athena:GetDataCatalog",
                    "athena:GetDatabase",
                    "athena:GetTableMetadata",
                    "athena:ListDatabases",
                    "athena:ListTableMetadata"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:athena:${AWS::Region}:${AWS::AccountId}:datacatalog/AwsDataCatalog"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "glue:GetDatabase",
                    "glue:GetDatabases",
                    "glue:CreateDatabase",
                    "glue:GetTable",
                    "glue:GetTables",
                    "glue:CreateTable",
                    "glue:UpdateTable",
                    "glue:DeleteTable",
                    "glue:BatchDeleteTable",
                    "glue:GetPartitions",
                    "glue:GetPartition",
                    "glue:BatchGetPartition",
                    "glue:BatchCreatePartition",
                    "glue:BatchDeletePartition",
                    "glue:GetTableVersions"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:catalog"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:database/medallion_lab*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:glue:${AWS::Region}:${AWS::AccountId}:table/medallion_lab*/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "Task": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "512",
        "Memory": "1024",
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "dbt",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "Environment": [
              {
                "Name": "AWS_DEFAULT_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "DATA_BUCKET",
                "Value": {
                  "Ref": "DataBucket"
                }
              },
              {
                "Name": "RESULTS_BUCKET",
                "Value": {
                  "Ref": "ResultsBucket"
                }
              },
              {
                "Name": "ATHENA_WORKGROUP",
                "Value": {
                  "Ref": "Workgroup"
                }
              },
              {
                "Name": "DBT_PROFILES_DIR",
                "Value": "/app/dbt"
              },
              {
                "Name": "DBT_SEND_ANONYMOUS_USAGE_STATS",
                "Value": "false"
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "dbt"
              }
            }
          }
        ]
      }
    },
    "WorkflowRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "states.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "lab",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecs:RunTask"
                  ],
                  "Resource": {
                    "Ref": "Task"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecs:StopTask",
                    "ecs:DescribeTasks"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "ArnEquals": {
                      "ecs:cluster": {
                        "Fn::GetAtt": [
                          "Cluster",
                          "Arn"
                        ]
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "iam:PassRole"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "ExecutionRole",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "TaskRole",
                        "Arn"
                      ]
                    }
                  ],
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "ecs-tasks.amazonaws.com"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "events:PutRule",
                    "events:PutTargets",
                    "events:DescribeRule"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:events:${AWS::Region}:${AWS::AccountId}:rule/StepFunctionsGetEventsForECSTaskRule"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Workflow": {
      "Type": "AWS::StepFunctions::StateMachine",
      "Properties": {
        "StateMachineType": "STANDARD",
        "RoleArn": {
          "Fn::GetAtt": [
            "WorkflowRole",
            "Arn"
          ]
        },
        "Definition": {
          "StartAt": "RunDbt",
          "TimeoutSeconds": 1800,
          "States": {
            "RunDbt": {
              "Type": "Task",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:states:::ecs:runTask.sync"
              },
              "Parameters": {
                "LaunchType": "FARGATE",
                "Cluster": {
                  "Fn::GetAtt": [
                    "Cluster",
                    "Arn"
                  ]
                },
                "TaskDefinition": {
                  "Ref": "Task"
                },
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": [
                      {
                        "Ref": "Subnet"
                      }
                    ],
                    "SecurityGroups": [
                      {
                        "Ref": "SecurityGroup"
                      }
                    ],
                    "AssignPublicIp": "ENABLED"
                  }
                },
                "Overrides": {
                  "ContainerOverrides": [
                    {
                      "Name": "dbt",
                      "Environment": [
                        {
                          "Name": "FORCE_FAIL",
                          "Value.$": "$.force_fail"
                        }
                      ]
                    }
                  ]
                }
              },
              "ResultPath": "$.task",
              "Next": "CheckExit"
            },
            "CheckExit": {
              "Type": "Choice",
              "Choices": [
                {
                  "And": [
                    {
                      "Variable": "$.task.Containers[0].ExitCode",
                      "IsPresent": true
                    },
                    {
                      "Variable": "$.task.Containers[0].ExitCode",
                      "NumericEquals": 0
                    }
                  ],
                  "Next": "Done"
                }
              ],
              "Default": "DbtFailed"
            },
            "Done": {
              "Type": "Succeed"
            },
            "DbtFailed": {
              "Type": "Fail",
              "Error": "DbtFailed",
              "Cause": "Container failed; inspect CloudWatch and S3 artifacts."
            }
          }
        }
      },
      "DependsOn": [
        "Route",
        "Association"
      ]
    }
  },
  "Outputs": {
    "WorkflowArn": {
      "Value": {
        "Ref": "Workflow"
      }
    },
    "WorkgroupName": {
      "Value": {
        "Ref": "Workgroup"
      }
    },
    "TaskRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "TaskRole",
          "Arn"
        ]
      }
    },
    "LogGroupName": {
      "Value": {
        "Ref": "Logs"
      }
    },
    "ClusterArn": {
      "Value": {
        "Fn::GetAtt": [
          "Cluster",
          "Arn"
        ]
      }
    }
  }
}